# -*- mode: ruby -*-
# vi: set ft=ruby :

# Configuration version 2
Vagrant.configure("2") do |config|

  # Box bento/ubuntu-24.04
  config.vm.box = "bento/ubuntu-24.04"
  # Set hostname
  config.vm.hostname = "sysd-obb"
  # Disable automatic box update checking.
  config.vm.box_check_update = false

  # Fine-tune various backing providers for Vagrant.
  config.vm.provider "virtualbox" do |vb|
    # Display the VirtualBox GUI when booting the machine
    vb.gui = false  
    # Customize the amount of memory on the VM:
    vb.memory = "2048"
    vb.cpus = 2
    # Forwarding port 808(1,2) from host to VM port 808(1,2)
    config.vm.network "forwarded_port", guest: 8081, host: 8081
    config.vm.network "forwarded_port", guest: 8082, host: 8082
  end

  config.vm.provision "shell", inline: <<-'SHELL'
    echo 'force_color_prompt=yes' >> /root/.bashrc
    echo "PS1='\[\033[01;31m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '" >> /root/.bashrc
  SHELL

  config.vm.provision "shell", path: "unit.sh"
  config.vm.provision "shell", path: "spawn.sh"
  config.vm.provision "shell", path: "nginx.sh"
end
